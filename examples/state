Attributes:
  - Name: token value set in conf file
    Privilege: !None
    Detail: !LineInFile
      FilePath: ~/my_token
      Line: "A_VERY_LONG_TOKEN"
      State: !Present
      InsertAfter: BOF

  - Name: bluetooth available
    Privilege: !None
    Detail: !Service
      Name: "{{ service_name }}"
      State: !Started
      Enabled: true